#!/usr/bin/env python3
"""Publish an explicit reply for HerdrDesk without collecting terminal history."""
import argparse
import json
import os
import plistlib
from pathlib import Path
import re
import secrets
import shutil
import subprocess
from datetime import datetime, timezone


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--text")
    source.add_argument("--body-file", type=Path)
    team_only = Path(__file__).name == "herdr-team-message"
    parser.add_argument("--progress", action="store_true", help="publish an intermediate progress update")
    parser.add_argument("--team", required=team_only, help="explicitly share the message with this HerdrDesk team ID")
    parser.add_argument("--handoff-to", metavar="ADDRESS", help="publish a copy of an inter-agent message already sent to this Herdr address")
    args = parser.parse_args()
    if args.team is not None and (not args.team.strip() or len(args.team) > 120 or any(ord(char) < 32 for char in args.team)):
        parser.error("a team ID must contain 1 to 120 printable characters")
    body = args.text if args.text is not None else args.body_file.read_text(encoding="utf-8")
    if not body.strip() or len(body.encode("utf-8")) > 65536:
        parser.error("a reply must contain between 1 and 65536 UTF-8 bytes")
    hc = os.environ.get("HERDRDESK_HC") or shutil.which("hc") or str(Path.home() / ".local/bin/hc")
    address = os.environ.get("HC_TERMINAL_ID")
    if not address:
        parser.error("run this inside your own Herdr terminal")

    def run(*command, text=None):
        return subprocess.run([hc, *command], input=text, capture_output=True,
                              text=True, check=True, timeout=20).stdout

    terminal = json.loads(run("get", "--json", address))
    labels = terminal.get("labels") or {}
    role = labels.get("recovery.role", "")
    if (not re.fullmatch(r"[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}", role)
            or terminal.get("state") != "live"
            or (terminal.get("status") or {}).get("app") not in ("codex", "claude-code")
            or not terminal.get("pid") or not terminal.get("created_ms")):
        parser.error("a live coding agent with a usable recovery.role is required")

    recipient = ""
    if args.handoff_to:
        if args.team or args.progress or args.handoff_to.startswith("-") or args.handoff_to == address:
            parser.error("a handoff needs a different recipient address and no --team or --progress")
        target = json.loads(run("get", "--json", args.handoff_to))
        recipient = (target.get("labels") or {}).get("recovery.role", "")
        if (not re.fullmatch(r"[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}", recipient)
                or recipient == role or target.get("state") != "live"
                or (target.get("status") or {}).get("app") not in ("codex", "claude-code")
                or not target.get("pid") or not target.get("created_ms")):
            parser.error("the recipient must be a different live, registered coding agent")
    terminal_team = labels.get("team.id")
    if args.team and terminal_team and terminal_team != args.team:
        parser.error("this terminal belongs to a different team")

    stamp = datetime.now(timezone.utc)
    reply_id = stamp.strftime("r%Y%m%d%H%M%S") + secrets.token_hex(3)
    bundled_info = Path(__file__).resolve().parents[2] / "Info.plist"
    legacy = False
    if bundled_info.is_file():
        with bundled_info.open("rb") as settings:
            legacy = plistlib.load(settings).get("HerdrDeskLegacyProfile", False)
    default_root = Path.home() / (".local/state/herdr-desk/results" if legacy
                                  else "Library/Application Support/HerdrDesk Preview/results")
    root = Path(os.environ.get("HERDRDESK_RESULTS") or default_root)
    if not root.is_absolute():
        parser.error("HERDRDESK_RESULTS must be an absolute directory")
    progress = args.progress or Path(__file__).name == "herdr-progress"
    kind = "agent-handoff" if recipient else "progress" if progress else "team-message" if args.team else "reply"
    record = {
        "id": reply_id, "role": role, "session": f"{terminal['created_ms']}:{terminal['pid']}",
        "at": stamp.isoformat(timespec="seconds").replace("+00:00", "Z"),
        "body": body, "title": {"agent-handoff": "Agent handoff", "progress": "Progress update", "team-message": "Team message", "reply": "Reply"}[kind],
        "kind": kind, "state": "published",
    }
    if recipient:
        record["recipient"] = recipient
    if args.team:
        record["team"] = args.team
    run("file", "write", str(root / role / (reply_id + ".json")), text=json.dumps(record, ensure_ascii=False))
    run("label", address, "result.latest=" + reply_id)
    print(reply_id)


if __name__ == "__main__":
    main()
