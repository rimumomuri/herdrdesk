#!/usr/bin/env python3
"""Register explicit task lineage once. JSON metadata comes from stdin; no history is collected."""
import argparse
import os
from pathlib import Path
import subprocess
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("operation", choices=["task", "edge", "delegate", "accept", "complete", "pending"])
args = parser.parse_args()
data = sys.stdin.buffer.read(65537)
if len(data) > 65536:
    parser.error("input exceeds 65536 bytes")
bundled = Path(__file__).resolve().parents[2] / "MacOS/HerdrDesk"
tool = Path(os.environ.get("HERDRDESK_LINEAGE_TOOL") or bundled)
if not tool.is_absolute() or not tool.is_file():
    parser.error("set HERDRDESK_LINEAGE_TOOL to the pinned HerdrDesk executable")
result = subprocess.run([str(tool), "--lineage", args.operation], input=data)
sys.exit(result.returncode)
